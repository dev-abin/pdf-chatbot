# Runnable local defaults. Copy to .env before Docker Compose.
DATABASE_URL=sqlite:////app/data/documind.db
JWT_SECRET=replace-with-a-long-random-secret-before-sharing

LLM_PROVIDER=ollama
PREF_MODEL=llama3.2
OLLAMA_API_URL=http://host.docker.internal:11434

EMBEDDING_PROVIDER=huggingface
PREF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

UPLOAD_FILE_URL=http://backend:8000/api/upload-files/
CHAT_API_URL=http://backend:8000/api/chat/
AUTH_LOGIN_URL=http://backend:8000/auth/login
AUTH_REGISTER_URL=http://backend:8000/auth/register

