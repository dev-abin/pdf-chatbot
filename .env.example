# === Environment Configuration ===
# Copy this file to .env and fill in the values.

APP_ENV=local

# ----------------------------------
# LLM Provider: "ollama" or "openai"
# ----------------------------------
LLM_PROVIDER=ollama

# Ollama-specific (required when LLM_PROVIDER=ollama)
OLLAMA_API_URL=http://localhost:11434

# OpenAI-specific (required when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # optional (for Azure, self-hosted, etc.)

# Model preferences
PREF_MODEL=your-model-here

# ----------------------------------
# Embedding Provider: "huggingface", "openai", or "ollama"
# ----------------------------------
EMBEDDING_PROVIDER=huggingface
PREF_EMBEDDING_MODEL=your-embedding-model-here

# ----------------------------------
# Database (PostgreSQL)
# ----------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# ----------------------------------
# Authentication (JWT)
# ----------------------------------
JWT_SECRET=your-secret-key-here

# ----------------------------------
# Frontend <-> Backend URLs
# ----------------------------------
UPLOAD_FILE_URL=http://localhost:8000/api/upload-files/
CHAT_API_URL=http://localhost:8000/api/chat/
AUTH_LOGIN_URL=http://localhost:8000/auth/login
AUTH_REGISTER_URL=http://localhost:8000/auth/register
